# Sao chép file này thành .env.local rồi điền thông tin thật.
# KHÔNG commit .env.local.
#
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<database>
# Ký tự đặc biệt trong mật khẩu (@ : / # ? %) phải được URL-encode, ví dụ "@" -> "%40".
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/oc_studio
#
# Trên Vercel + Neon (tích hợp Neon tự điền, xem docs/deploy-vercel.md):
#   DATABASE_URL           = chuỗi POOLED của Neon (host có "-pooler") — app dùng chuỗi này.
#   DATABASE_URL_UNPOOLED  = chuỗi kết nối trực tiếp — chỉ dùng để chạy migration lúc build.
# DATABASE_URL_UNPOOLED=

# Ảnh tải lên. Có BLOB_READ_WRITE_TOKEN => lưu trong Vercel Blob (store PRIVATE), trình duyệt tải
# ảnh thẳng lên Blob. Để trống => lưu trên đĩa ở MEDIA_STORAGE_DIR (chạy local).
# Lấy token: Vercel → Storage → Blob store → tab ".env.local" (chỉ cần khi chạy script chuyển ảnh).
# BLOB_READ_WRITE_TOKEN=
# Tùy chọn — thư mục lưu ảnh trên đĩa khi KHÔNG dùng Blob. Mặc định: <thư mục dự án>/storage
# MEDIA_STORAGE_DIR=D:/OC Studio/storage

# Đăng nhập (một người dùng). BẮT BUỘC khi chạy production (`next start`, Vercel): thiếu một
# trong hai biến thì app từ chối MỌI request (lỗi 503), không bao giờ tự mở cửa.
# Chạy local bằng `pnpm dev`: để trống CẢ HAI thì không cần đăng nhập như trước.
# Đổi APP_PASSWORD hoặc AUTH_SECRET sẽ đăng xuất mọi thiết bị.
APP_PASSWORD=
# Khóa ký cookie phiên, tối thiểu 32 ký tự, ngẫu nhiên. Tạo bằng một trong các lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   openssl rand -base64 32
AUTH_SECRET=

# Tùy chọn — chỉ cho integration tests (đặt trong .env.test.local). Tên database PHẢI kết thúc bằng _test.
# Bỏ trống thì dùng DATABASE_URL với tên database thêm hậu tố _test (oc_studio → oc_studio_test).
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/oc_studio_test
# AI (optional, server-only). Default Gemini: use a Free Tier project without billing.
# The app cannot determine project billing status from an API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Models offered in the AI dialog (comma-separated ids). GEMINI_MODEL is the default and must be
# listed. Unset = the Flash / Flash-Lite models verified in code. The list only limits what the
# app offers: it does not prove your project is on the Free Tier (billing-enabled projects pay).
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# OpenAI is called ONLY when AI_PROVIDER=openai is explicitly set (paid API).
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: how long one AI request may run before the server aborts it (ms, 10000–280000).
# Default 240000 (4 minutes). The cap keeps a job inside one Vercel function run (300 s on Hobby).
# Aborting does not guarantee the provider stopped working on it.
AI_REQUEST_TIMEOUT_MS=
