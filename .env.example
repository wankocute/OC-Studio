# Sao chép file này thành .env.local rồi điền thông tin thật.
# KHÔNG commit .env.local.
#
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<database>
# Ký tự đặc biệt trong mật khẩu (@ : / # ? %) phải được URL-encode, ví dụ "@" -> "%40".
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/oc_studio

# Tùy chọn — thư mục lưu ảnh tải lên (ngoài public/). Mặc định: <thư mục dự án>/storage
# MEDIA_STORAGE_DIR=D:/OC Studio/storage

# Tùy chọn — chỉ cho integration tests (đặt trong .env.test.local). Tên database PHẢI kết thúc bằng _test.
# Bỏ trống thì dùng DATABASE_URL với tên database thêm hậu tố _test (oc_studio → oc_studio_test).
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/oc_studio_test
# AI (optional, server-only). Default Gemini: use a Free Tier project without billing.
# The app cannot determine project billing status from an API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Models offered in the AI dialog (comma-separated ids). GEMINI_MODEL is the default and must be
# listed. Unset = the Flash / Flash-Lite models verified in code. The list only limits what the
# app offers: it does not prove your project is on the Free Tier (billing-enabled projects pay).
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# OpenAI is called ONLY when AI_PROVIDER=openai is explicitly set (paid API).
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: how long one AI request may run before the server aborts it (ms, 10000–900000).
# Default 300000 (5 minutes). Aborting does not guarantee the provider stopped working on it.
AI_REQUEST_TIMEOUT_MS=
